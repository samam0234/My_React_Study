# docker compose 용 환경 변수 예시 (값은 .env 에 — .env 는 커밋하지 않는다)
WEB_PORT=8080
DB_PASSWORD=
SPRING_PROFILES_ACTIVE=
# 운영(prod)에서는 필수: 32바이트 이상의 임의 문자열 (예: openssl rand -base64 48)
JWT_SECRET=
# 데모 데이터(mina/jun/admin@example.com, 비밀번호 password123) — 운영에서는 false
APP_SEED=true
# AI: 키가 없으면 모의 응답. 실제 모델을 쓰려면 키만 넣으면 된다(AI_PROVIDER 는 비워도 됨)
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_DAILY_TOKEN_LIMIT=200000
# MCP 서버(선택, --profile mcp): 서비스 전용 토큰(긴 랜덤 값)
MCP_SERVICE_TOKEN=
